# Run npm run setup to create a private .env with a generated host password.
HOST_PASSWORD=replace-with-a-long-private-password
PORT=3000
DATABASE_PATH=./data/party.sqlite
GAME_CONFIG_PATH=./config/game.yaml
NODE_ENV=development
# Rehearsal uses a connection-check round, not unfinished game mechanics.
ENABLE_REHEARSAL=true
# Set to your final HTTPS origin in production; cookies will be Secure.
# PUBLIC_ORIGIN=https://game.bowen-hou.com

# Defaults to the demo bank. For a NEW event party, select the tracked event bank.
# TRIVIA_BANK_FILE=./config/trivia-event.json

# Optional event file for the host's demo toggle; defaults to ./config/trivia-event.json.
# TRIVIA_EVENT_BANK_FILE=./config/trivia-event.json

# Browser key: Vite exposes this value to the TV page. Restrict it to Maps JavaScript API
# and the local/production website origins.
VITE_GOOGLE_MAPS_API_KEY=
