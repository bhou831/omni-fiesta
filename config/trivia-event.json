  "adventureRules": {
    "charadesSimple": [
      "每队派两位队员：一人负责比划，另一人负责猜。",
      "表演者可以说话，但不能说出题目中的词，也不能直接说出答案的一部分。",
      "可以用动作、表情和声音提示。",
      "2 分钟内猜中 6 题即挑战成功；可以跳过，跳过后继续抽题。"
    ],
    "yesOrNoSimple": [
      "每队派一位代表抽题。代表不能看屏幕上的挑战内容，由主持人或队友将题目展示给其他队员。",
      "代表通过提问猜出挑战内容。队友只能回答 Yes 或 No，不能做动作、提示答案或补充解释。",
      "代表猜出挑战后，必须在规定时间内完成挑战。3 分钟内猜出并完成即成功。",
      "涉及他人物品、饮食或身体接触时，必须先征得对方同意；不同意时由主持人换题。"
    ],
    "charadesComplex": [
      "每队派两位队员：一人负责比划，另一人负责猜。",
      "表演者不能说话、发出声音、做口型、写字或拼字，只能用动作和表情提示。",
      "2 分钟内猜中 8 题即挑战成功；可以跳过，跳过后继续抽题。"
    ],
    "yesOrNoHard": [
      "玩法与简单轮相同：代表通过提问猜挑战，队友只能回答 Yes 或 No。",
      "代表猜出挑战后，必须在规定时间内完成。2 分钟内猜出并完成即成功。"
    ],
    "photoRecreation": [
      "每队有两分钟还原大屏幕上的图片。",
      "主持人根据现场拍摄结果判定挑战成功或失败。",
      "首队失败后，可开启抢答邀请另一队挑战第二张图片。"
    ]
  },
